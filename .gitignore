# Secrets — API keys, Discord webhook URL, Azure connection strings
.env
.env.*
!.env.example
deploy/local.env
*.pem
local.settings.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data — payload dumps, scratch databases, model files
*.db
*.sqlite3
*.dump
# `data/*` rather than `data/`: git does not descend into an ignored directory,
# so the negations below would never be considered.
data/*
# The universe files are the exception the rule exists around — the committed
# CSV is the review surface a reclassification has to pass through before it can
# move a score, and git is its audit trail.
!data/universe.csv
!data/universe-unresolved.csv
models/
*.onnx

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# SDD workspace (scratch)
.superpowers/
