# Copy to deploy/local.env for a local run of the whole stack.
#
# Nothing here is a real credential. Leaving the Infisical trio unset means the
# app reads this file as-is, which also switches GitHub sign-in off, so every
# page is reachable without an OAuth application.
POSTGRES_USER=screener
POSTGRES_PASSWORD=localdev
POSTGRES_DB=screener
# Published so you can reach the database with psql. 5432 and 5433 are often
# taken by a local install or another project; change it if 5435 is too.
POSTGRES_PORT=5435
SCREENER_IMAGE_TAG=local

# Signs local sessions. Any string will do here; it is not a shared secret with
# anything. Without it /auth/local has nothing to sign with and refuses.
SESSION_SECRET=local-development-only

# Fill these in to exercise the real integrations locally. Each one is inert
# while unset, so the stack starts either way.
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_DISCORD_USER_IDS=

# Per person, per rolling 24 hours. See .env.example.
DAILY_SPEND_CAP_USD=0.10

# Live stream capture. `localhost` has to be in the embed parents or the Twitch
# player shows a black frame here while working perfectly on the VPS.
SKYBIRD_CHUNK_SECONDS=15
SKYBIRD_MAX_SESSIONS=2
SKYBIRD_EMBED_PARENTS=localhost,screener.edenmatrix.xyz

# Read-only SQL from /playground and from Steven's `sql` tool. Unset, the role
# has no password, cannot log in, and the page reports itself switched off — so
# giving it one here is what turns the feature on locally. Never the same as
# POSTGRES_PASSWORD: the engine refuses a connection that turns out to be a
# superuser.
PLAYGROUND_DB_PASSWORD=local-development-only

# Social ingest. Empty deliberately, and not the default the code carries: a
# first pass backfills a week of r/wallstreetbets, which is over a hundred
# thousand comments pulled from a mirror run by volunteers. Set it when you mean
# to exercise the ingest, not every time you bring the stack up.
REDDIT_SUBREDDITS=
