# One origin for the dashboard and the status service, so the session cookie is
# same-site and there is no CORS surface at all.
#
# Cloudflare terminates TLS at its edge and the tunnel dials outward, so this
# speaks plain HTTP on the compose network and is never reachable from the host.
:8080 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The status service owns sign-in and the probes. /health and /ready stay
	# reachable without a session because the container healthcheck and the
	# deploy smoke test have no cookie to present.
	handle /auth/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	handle /ready {
		reverse_proxy api:8080
	}
	handle /status {
		reverse_proxy api:8080
	}
	# The dashboard's data, served by the status service. Ahead of the
	# catch-all below, which would otherwise hand it to Next.js.
	handle /api/* {
		reverse_proxy api:8080
	}

	# The MCP connector: the endpoint claude.ai calls, its OAuth server, and
	# the two discovery documents.
	#
	# These paths are not under /api/ because none of them is ours to choose:
	# /.well-known/* is fixed by RFC 9728 and RFC 8414, and /mcp is what gets
	# typed into Claude. Without a handle each, the catch-all hands them to
	# Next.js, which answers 307 to /login — and Claude drops the Authorization
	# header across a redirect, so the failure arrives as "authorization failed"
	# with nothing in this repo to explain it.
	#
	# `/mcp` and `/mcp/*` rather than `/mcp*`, which would also match /mcpanything.
	handle /mcp {
		reverse_proxy api:8080
	}
	handle /mcp/* {
		reverse_proxy api:8080
	}
	handle /oauth/* {
		reverse_proxy api:8080
	}
	handle /.well-known/* {
		reverse_proxy api:8080
	}

	# Everything else is the dashboard.
	handle {
		reverse_proxy web:3000
	}
}
