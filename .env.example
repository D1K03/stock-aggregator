# Local development only. In production every value below except the Infisical
# bootstrap trio is fetched from Infisical at startup and never written to
# disk. Nothing loads this file automatically — export it, or let compose read
# it with --env-file.

# Production / development database. On the VPS this is not set by hand —
# deploy/compose.prod.yaml builds it from the POSTGRES_* values below, so the
# password exists in exactly one place.
DATABASE_URL=postgresql://user:password@host:5432/screener

# Database used by the test suite. THIS SCHEMA IS DROPPED ON EVERY TEST.
# Point it at a throwaway database, never at DATABASE_URL.
#
# Host and port are spelled out because the throwaway database is the one in
# `compose.yaml`, reached over TCP; a bare `postgresql:///screener_test` asks
# libpq for a local unix socket instead and never finds it. Note also that
# nothing loads this file into pytest's environment -- CI sets the variable
# itself and fails rather than skipping, while locally an unset variable skips
# every database test and still reports green. Export it in your shell.
DATABASE_URL_TEST=postgresql://postgres:screener@localhost:5432/screener_test

# --- Secrets ----------------------------------------------------------------
# The machine identity that fetches everything else. These three are the only
# credentials stored on the server. Leave them unset locally and the process
# reads this file as-is.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
# How often a running process re-reads Infisical, so an edit there needs no
# restart. 60 unless set; 0 reads once at startup and never again.
INFISICAL_REFRESH_SECONDS=

# --- Fetching ---------------------------------------------------------------
# Bright Data, and every one of these is optional. Unset means the proxy
# strategies decline to run, which is the intended state: the default strategy
# list is ("direct",) and nothing reaches these unless a caller asks for it by
# name. Set BRIGHTDATA_PROXY to the combined form their dashboard shows, or the
# four discrete variables, not both.
BRIGHTDATA_PROXY=host:port:username:password
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=44445
BRIGHTDATA_PROXY_USER=
BRIGHTDATA_PROXY_PASS=
# The zone's exit addresses, comma separated, one lane pinned to each. This is
# the only setting that is not inert by default: Yahoo starts on the lanes, so
# setting it puts ~3,000 requests a night across these addresses instead of the
# box's own, and clearing it puts them back. A session suffix is a random draw
# from the zone rather than a rotation, which is why lanes pin by address.
BRIGHTDATA_PROXY_IPS=
# Web Unlocker is billed per successful request. Both are needed for it to run.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

# Where the transcription container answers inside the compose network. Never
# public: Caddy sends every /api/* path to the status service and everything
# else to the dashboard, so nothing on the internet resolves to it. Unset is the
# normal case and means the default service name, which is what production uses.
TRANSCRIBER_URL=

# Where the sentiment container answers inside the compose network, on the same
# terms as TRANSCRIBER_URL above: never public, and unset is the normal case.
# There is no switch here and no credential — the service either answers or it
# does not, which is why `boot selftest` reports it as OK or FAIL and never SKIP.
SENTIMENT_URL=

# --- Universe refresh --------------------------------------------------------
# Contact address for SEC's required User-Agent, used only by
# `python -m screener.universe refresh` (quarterly, by hand).
#
# Measured against the live endpoint: SEC answers 403 to a request whose
# User-Agent names nobody, AND to any User-Agent containing `github.com` —
# an address at that domain is refused as firmly as a bare repository URL.
# There is deliberately no default: a placeholder would be answered with a 403
# that reads as a network fault rather than as a missing setting.
SEC_CONTACT_EMAIL=

# --- Social ingest -----------------------------------------------------------
# Reddit posts and comments, read from Arctic Shift, a public mirror. Reddit's
# own API is not used: it answers unauthenticated requests with 403 whatever
# User-Agent is sent, its robots.txt disallows every agent, and an OAuth client
# needs manual approval. No credentials are needed for any of this.
#
# An empty subreddit list is how the ingest container is switched off; it logs
# that and exits cleanly rather than restarting.
REDDIT_SUBREDDITS=wallstreetbets,stocks
# How far back the first pass reaches, in days. Only the first, per subreddit.
REDDIT_BACKFILL_DAYS=7
REDDIT_REFRESH_HOURS=6
# Between pages, in milliseconds. Politeness towards a volunteer-run service
# rather than a published limit, and the one knob to reach for if they ask for
# less traffic.
REDDIT_DELAY_MS=1000
ARCTIC_SHIFT_URL=

# --- Insider transactions ------------------------------------------------------
# SEC Form 4, read from the EDGAR daily index. No key, no session and no proxy:
# sec.gov/robots.txt does not disallow /Archives/, and SEC publishes both the
# format and the rate it will serve.
#
# **Deliberately not SEC_CONTACT_EMAIL above.** That one drives the quarterly,
# hand-run universe refresh; sharing it would mean setting a contact address for
# a command run four times a year silently starts a daily crawler against the
# same service. Unset is how this container is switched off -- it logs that and
# exits cleanly. The same `github.com` rule applies: an address at that domain
# is refused with a 403 as firmly as no address at all.
EDGAR_CONTACT_EMAIL=
# How far back to consider, in days. Widening this **is** the backfill: the
# frontier is the set of days already walked, so a wider window simply offers
# more of them and the container drains them a pass at a time.
EDGAR_BACKFILL_DAYS=30
# How many unwalked days one pass takes, so a long backfill drains steadily
# rather than as one very long pass a deploy interrupts and starts over.
EDGAR_DAYS_PER_PASS=5
EDGAR_REFRESH_HOURS=12
# Between filings, in milliseconds. SEC publishes a limit of 10 requests a
# second and enforces it by blocking the address, so unlike REDDIT_DELAY_MS this
# is compliance rather than politeness. 150ms is about 6.7/s, leaving room for
# the universe refresh to be running at the same time.
EDGAR_DELAY_MS=150
EDGAR_ARCHIVE_URL=


# --- Rupert: which security a text is about ------------------------------------
# The join `screener.reddit` and `screener.magpie` both stopped short of. A regex
# shortlists candidate symbols, a decision model picks which one -- if any -- the
# sentence is actually about, and FinBERT reads how it sounds.
#
# **This is the only thing here that spends money per item, so it is off.** Zero
# means nobody may spend anything, never "no limit" -- the same reading
# DAILY_SPEND_CAP_USD takes. Setting it is how the container turns on, and
# because the process exits when it is zero, turning it on needs the container
# recreated (`docker compose up -d rupert`) rather than restarted.
#
# Measured on the live corpus: ~5.6% of items shortlist anything, so a day is
# roughly 1,080 decisions at about $0.00002 each -- call it $0.50 a month. Its
# own counter rather than DAILY_SPEND_CAP_USD, on magpie's precedent: one
# counter for the assistant and for a corpus pass would let a busy night in
# r/wallstreetbets silence Steven.
RUPERT_DAILY_MAX_CALLS=0
# Items examined per pass, per corpus. A ceiling for draining a backlog, not a
# target -- most of them shortlist nothing and cost only a regex.
RUPERT_BATCH=400
RUPERT_REFRESH_HOURS=6
# How far back a corpus never read before starts. **Zero means start now and
# never look back**, which is the intended first deploy: the first pass sets the
# frontier to the moment it runs and nothing already in social_item is decided.
#
# Measured: the corpus takes ~19,300 items a day, so setting this to 7 means
# ~135,000 items examined and ~7,600 paid decisions on the first wake. Widening
# it *is* the backfill — do it deliberately, on a day you are watching it. It
# only applies while a corpus has no rupert.progress row; after that the walk
# carries on from where it got to and this is ignored.
RUPERT_BACKFILL_DAYS=0
# How peaked the choice has to be before a mention counts as resolved, in whole
# percent. The model's own guidance is above 90 to act without review, and that
# is the floor here rather than a comfortable setting: an independent test
# measured it overconfident out of distribution (refit temperature 3.29).
# Anything below is still stored, with its whole distribution, as `unsure`.
RUPERT_CONFIDENCE_PCT=90
# Above this, a text is treated as trying to steer whatever reads it and is
# refused before anything it says is believed. Lower than the floor above on
# purpose: the same test found yes/no answers *under*confident out of
# distribution, so one that reaches 50 is saying more than it looks like.
RUPERT_INJECTION_PCT=50
# A hard ceiling in whole cents on what the decisions may cost in a day, checked
# against what OpenRouter actually billed. Belt as well as braces: the call cap
# above bounds spend only while the price per call is what we assume, and this
# one holds whatever the unit price does. A full night is about 2 cents, so 25 is
# roughly ten normal nights — it is a backstop for something going wrong, not a
# working limit. If this is what stops a pass, something else is already broken.
RUPERT_DAILY_MAX_CENTS=25


# --- Nightly scheduler ---------------------------------------------------------
# One pass a night: prices, then fundamentals, then scoring, in that order. The
# hour is in UTC and matters because `--as-of` refuses a past date — trigger
# after midnight and the run scores today, a day whose market has not opened,
# rather than the session that just closed.
NIGHTLY_TRIGGER_HOUR=23
# The incident switch: set to false to stop the pipeline running without a
# redeploy. The container exits 0 and `restart: unless-stopped` keeps bringing
# it back to exit again, so flipping this back on needs the container
# recreated (`docker compose up -d nightly`) -- `environment:` is baked in at
# create time, so a plain restart would not pick up the new value anyway.
NIGHTLY_ENABLED=true

# --- Playground --------------------------------------------------------------
# Read-only SQL from the dashboard, and Steven's `sql` tool. Both connect as a
# separate Postgres role that holds SELECT on the tables listed in migration 013
# and nothing else: not sign-in, not the audit trail. The application's own
# connection is the cluster superuser, on which a SQL box would be arbitrary
# file read, which is why this exists at all.
#
# Unset is the off switch. The role is created without a password and cannot
# authenticate until this is given one, so the page reports itself switched off
# rather than failing. Never set this to the application's own password; the
# engine refuses to serve a connection that turns out to be a superuser.
PLAYGROUND_DB_PASSWORD=

# The same console, one role narrower, for Steven's `sql` tool. `playground_bot`
# is `playground` minus the skybird schema: he works a capture's controls and
# cannot read a transcript back, and after migration 017 that is a grant rather
# than a missing tool.
#
# Deliberately a second password rather than a second URL off the first. Whoever
# holds a password can connect as that role, so one shared secret would make the
# split a matter of which connection string the Python picked. The api container
# holds both — it provisions them — and the bot container holds only this one.
PLAYGROUND_BOT_DB_PASSWORD=

# The MCP connector's role, for claude.ai. `playground_mcp` is granted the same
# public tables plus the skybird transcripts -- see `018_mcp.sql`, which says
# out loud that granting it sends transcripts off this box.
#
# Unset is the off switch: the role has no password, cannot log in, and /mcp
# reports itself switched off. Note this has to be in the `.env` file on the
# VPS rather than only in Infisical, because compose interpolates the URL above
# before the container starts and Infisical is read after it does.
PLAYGROUND_MCP_DB_PASSWORD=

# --- Skybird: live stream capture --------------------------------------------

# How long a chunk of audio is, and so how far behind live the transcript runs.
# 15 reads as live; 60 reads as a log. Five is the floor and 120 the ceiling,
# which is where `screener.transcribe` refuses a clip anyway.
SKYBIRD_CHUNK_SECONDS=15

# How many streams may be captured at once. One shared transcriber holds a
# semaphore of one, so a third stream would spend more time queued behind the
# other two than decoding — and would push the dashboard's mic button toward its
# thirty second busy wait. Raising this wants a second transcribe container,
# which is a TRANSCRIBER_URL away and not a code change.
SKYBIRD_MAX_SESSIONS=2

# Hostnames that may frame a Twitch player, comma separated. Twitch checks this
# against the page serving the embed and answers a mismatch with a black frame
# rather than an error, so a wrong value here fails silently. Unset means the
# tunnel hostname and localhost.
SKYBIRD_EMBED_PARENTS=

# Where audio chunks are held between ffmpeg and the transcriber. A tmpfs in
# production, so nothing is ever written to a disk; each file is unlinked as
# soon as it has been read.
SKYBIRD_WORK_DIR=

# --- LLM --------------------------------------------------------------------
# Narrative extraction only — never a sentiment number. The layer is inert
# without a key. Set the spend cap on the key in OpenRouter's dashboard rather
# than trying to enforce one here.
OPENROUTER_API_KEY=
AI_MODEL=deepseek/deepseek-v4-flash
APP_BASE_URL=http://localhost:8080

# --- Sign-in ----------------------------------------------------------------
# GitHub OAuth application. The callback must be exactly <APP_BASE_URL>/auth/callback,
# and an OAuth app holds only one, so local and prod need separate applications.
# Sign-in is inert until all three are set: /auth/login reports that it is not
# configured rather than half-working. That closes the protected routes rather
# than opening them — a session is required unconditionally. Only /health and
# /ready stay open, because the container healthcheck and the deploy smoke test
# cannot hold one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session tokens stored in the auth schema. Rotating it signs
# everyone out, which is the only revocation this needs.
SESSION_SECRET=
# Comma separated GitHub logins. Empty permits nobody, never everybody.
ALLOWED_GITHUB_LOGINS=
SESSION_DAYS=30

# --- Alerting ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# The gateway bot, which is a separate process from alert delivery above.
# Inert without a token. The guild id scopes command registration: without it
# commands register globally and take about an hour to appear. An empty
# allow-list permits nobody, never everybody.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_DISCORD_USER_IDS=
# What the bot answers on when mentioned. Must be one of the models in
# screener.ai.models, or it falls back to the default rather than billing
# against something nobody chose.
DISCORD_BOT_MODEL=upstage/solar-pro4
# Which Discord account belongs to which signed-in web user, so a conversation
# started in the dashboard can be handed over. `github-login:discord-id` pairs,
# comma separated. Personal account identifiers, so they live here and in
# Infisical rather than in the repository.
DISCORD_USER_MAP=
# Where the bot turns a chart into a PNG for Discord. The web container inside
# the same compose network, by default; there is nothing to set unless the bot
# runs somewhere else. Never public — Caddy sends every /api/* path to the
# status service, so this handler has no route from the internet.
CHART_RENDERER_URL=http://web:3000/api/render

# What any one person may spend on model calls in a rolling 24 hours, in
# dollars. A reply costs a few hundredths of a penny, so this is not about the
# normal case — it is the ceiling on a loop, a script, or someone holding down
# enter, where otherwise the first anyone knows is the invoice.
#
# Counted per person, folding Discord onto GitHub through DISCORD_USER_MAP, so
# it cannot be doubled by asking on the other surface. `0` stops everyone;
# unset falls back to the default below.
DAILY_SPEND_CAP_USD=0.10

# --- Database (VPS only) ----------------------------------------------------
# Read by deploy/compose.prod.yaml for both the postgres service and the
# DATABASE_URL it composes for the app. Not used locally.
POSTGRES_USER=screener
POSTGRES_PASSWORD=
POSTGRES_DB=screener

# --- Deployment -------------------------------------------------------------
# Read by deploy/compose.tunnel.yaml on the VPS. The tunnel is token-based, so
# this carries the tunnel id and secret; the hostname mapping lives in the
# Cloudflare Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
# Set by the deploy workflow to the commit being released. Defaults to latest.
SCREENER_IMAGE_TAG=latest

# --- Payload store -----------------------------------------------------------
# Where raw API responses land. blob_path is not null and every score traces
# back to a stored response, so nothing here prunes.
#
# `s3` (Cloudflare R2) is THE PRODUCTION VALUE and Infisical must carry it for
# the VPS. `local` is a directory, and it is the right default only for tests
# and local development: on the VPS a `local` backend writes the evidence into
# the container's own filesystem, which the next rollout destroys — while
# ingest_observation.blob_path goes on recording that the payload exists. That
# is the one promise the database cannot check for itself.
BLOB_BACKEND=local
BLOB_LOCAL_DIR=data/blobs
# Required whenever BLOB_BACKEND=s3 — S3Store refuses to start without all four,
# because a 403 from a missing key is indistinguishable from a 403 from clock
# skew. R2 wants `auto` as the region. Endpoint is
# https://<account>.r2.cloudflarestorage.com
BLOB_S3_ENDPOINT=
BLOB_S3_BUCKET=
BLOB_S3_ACCESS_KEY_ID=
BLOB_S3_SECRET_ACCESS_KEY=
BLOB_S3_REGION=auto

# ---- Magpie: the scraper ----------------------------------------------------
# Where the scraper is. The status service and the bot both ask it; neither
# holds a parser or a proxy credential of its own.
MAGPIE_URL=http://magpie:8082

# The routes it may try, cheapest first. `direct` is free; `isp_proxy` is
# bandwidth against a flat monthly plan already paid for, so its marginal cost
# is zero; `unlocker` is roughly $0.002 per successful request and is the only
# rung that spends anything. Drop `unlocker` to make scraping free outright.
MAGPIE_STRATEGIES=direct,isp_proxy,unlocker

# How many billed fetches a day, across everyone.
#
# Deliberately NOT DAILY_SPEND_CAP_USD. That cap defaults to $0.10 and a reply
# costs about $0.00005, so fifty scrapes would exhaust the whole daily allowance
# and the symptom would be Steven going quiet — a scraping feature starving the
# assistant. The cost is still recorded on the audit trail; this is the gate.
MAGPIE_UNLOCKER_DAILY_MAX=20

# Seconds between two requests to the same host, unless its robots.txt asks for
# longer. One person pasting one link never meets this.
MAGPIE_HOST_DELAY=1.0

# Identifies the scraper to a site, and is the agent robots.txt is checked
# against. A real contact address, because a host that wants to complain should
# be able to.
# MAGPIE_USER_AGENT=MagpieBot/1.0 (+https://github.com/D1K03/stock-aggregator)
