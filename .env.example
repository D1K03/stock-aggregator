# Local development only. In production every value below except the Infisical
# bootstrap trio is fetched from Infisical at startup and never written to
# disk. Nothing loads this file automatically — export it, or let compose read
# it with --env-file.

# Production / development database. On the VPS this is not set by hand —
# deploy/compose.prod.yaml builds it from the POSTGRES_* values below, so the
# password exists in exactly one place.
DATABASE_URL=postgresql://user:password@host:5432/screener

# Database used by the test suite. THIS SCHEMA IS DROPPED ON EVERY TEST.
# Point it at a throwaway database, never at DATABASE_URL.
DATABASE_URL_TEST=postgresql:///screener_test

# --- Secrets ----------------------------------------------------------------
# The machine identity that fetches everything else. These three are the only
# credentials stored on the server. Leave them unset locally and the process
# reads this file as-is.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod

# --- Fetching ---------------------------------------------------------------
# Bright Data, and every one of these is optional. Unset means the proxy
# strategies decline to run, which is the intended state: the default strategy
# list is ("direct",) and nothing reaches these unless a caller asks for it by
# name. Set BRIGHTDATA_PROXY to the combined form their dashboard shows, or the
# four discrete variables, not both.
BRIGHTDATA_PROXY=host:port:username:password
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=44445
BRIGHTDATA_PROXY_USER=
BRIGHTDATA_PROXY_PASS=
# Web Unlocker is billed per successful request. Both are needed for it to run.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

# --- LLM --------------------------------------------------------------------
# Narrative extraction only — never a sentiment number. The layer is inert
# without a key. Set the spend cap on the key in OpenRouter's dashboard rather
# than trying to enforce one here.
OPENROUTER_API_KEY=
AI_MODEL=deepseek/deepseek-v4-flash
APP_BASE_URL=http://localhost:8080

# --- Sign-in ----------------------------------------------------------------
# GitHub OAuth application. The callback must be exactly <APP_BASE_URL>/auth/callback.
# Sign-in is inert until all three are set, and /status is then open.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session tokens stored in the auth schema. Rotating it signs
# everyone out, which is the only revocation this needs.
SESSION_SECRET=
# Comma separated GitHub logins. Empty permits nobody, never everybody.
ALLOWED_GITHUB_LOGINS=
SESSION_DAYS=30

# --- Alerting ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Database (VPS only) ----------------------------------------------------
# Read by deploy/compose.prod.yaml for both the postgres service and the
# DATABASE_URL it composes for the app. Not used locally.
POSTGRES_USER=screener
POSTGRES_PASSWORD=
POSTGRES_DB=screener

# --- Deployment -------------------------------------------------------------
# Read by deploy/compose.tunnel.yaml on the VPS. The tunnel is token-based, so
# this carries the tunnel id and secret; the hostname mapping lives in the
# Cloudflare Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
# Set by the deploy workflow to the commit being released. Defaults to latest.
SCREENER_IMAGE_TAG=latest
